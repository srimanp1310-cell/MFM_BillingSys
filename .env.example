# Copy to .env and fill in real values. Never commit .env.
SECRET_KEY=change-me-to-a-long-random-string
# Dev default is SQLite in instance/app.db; set DATABASE_URL for Postgres in prod:
# DATABASE_URL=postgresql+psycopg://user:password@host:5432/dbname
DATABASE_URL=
FLASK_APP=wsgi.py
FLASK_DEBUG=1

# Web Push (Phase 8) — generate with: flask gen-vapid
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_CLAIM_EMAIL=mailto:admin@example.com
SECURE_COOKIES=1
