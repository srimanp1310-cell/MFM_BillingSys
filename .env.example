# ============================================================
# MFM Billing — environment variables
# Local: copy to .env and edit. Never commit .env (gitignored).
# Railway: set the PRODUCTION values in the service's Variables tab.
# ============================================================

# --- Required everywhere ---

# Secret key for sessions + CSRF.
# Generate: python -c "import secrets; print(secrets.token_hex(32))"
# Production refuses to start with the built-in dev key.
SECRET_KEY=change-me-to-a-long-random-string

# Flask CLI entrypoint (needed for `flask db upgrade`, `flask seed-admin`, ...)
FLASK_APP=wsgi.py

# --- Database ---
# Local: leave empty -> SQLite at instance/app.db
# Railway: auto-injected by the PostgreSQL plugin (do NOT set manually).
#          postgres:// and postgresql:// are auto-normalized to psycopg3.
DATABASE_URL=

# --- Local development only ---
# Enables debug mode + auto-reload. NEVER set this in production.
FLASK_DEBUG=1

# --- Production only (Railway) ---
# Marks the deployment as HTTPS: enables Secure session cookies and the
# SECRET_KEY safety check. Set to 1 on Railway; leave unset locally.
# SECURE_COOKIES=1

# --- Optional ---
# Shop timezone for bill dates and per-year bill numbering.
TIMEZONE=Asia/Kolkata
# Currency fallback if not set in Admin > Settings.
# CURRENCY_SYMBOL=₹

# --- Web Push (low-stock notifications) ---
# Generate the key pair with: flask gen-vapid
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_CLAIM_EMAIL=mailto:admin@example.com
